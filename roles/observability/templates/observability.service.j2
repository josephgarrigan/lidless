[Unit]
Description=Ephemeral Observability Triad (Vector, Dozzle, Gatus)
Documentation=https://vector.dev https://dozzle.dev https://gatus.io
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ observability_base_dir }}
ExecStart=/usr/bin/docker compose --file {{ observability_base_dir }}/docker-compose.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --file {{ observability_base_dir }}/docker-compose.yaml down
ExecReload=/usr/bin/docker compose --file {{ observability_base_dir }}/docker-compose.yaml up -d --force-recreate
TimeoutStartSec=300
TimeoutStopSec=60
Restart=no

[Install]
WantedBy=multi-user.target
